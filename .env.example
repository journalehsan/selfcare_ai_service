# Server Configuration
HOST=0.0.0.0
PORT=5732
WORKERS=4
MAX_JSON_PAYLOAD_SIZE=2000000

# Local AI Models (runtime never downloads files or calls a cloud API)
# Global default; /api/chat system_prompt overrides it (empty string omits it).
SYSTEM_PROMPT="You are a helpful assistant. Answer the user's request directly and concisely."
MODEL_NAME=TinyLlama/TinyLlama-1.1B-Chat-v1.0
MODEL_PATH=models/shared/tinyllama-1.1b
CONTEXT_LENGTH=2048
TINY_MAX_TOKENS=256
FALLBACK_MODEL_NAME=Qwen2.5-7B-Instruct-Q4_K_M
FALLBACK_MODEL_PATH=models/fallback/qwen2.5-7b-instruct/Qwen2.5-7B-Instruct-Q4_K_M.gguf
FALLBACK_TOKENIZER_PATH=models/fallback/qwen2.5-7b-instruct/tokenizer.json
FALLBACK_CONTEXT_LENGTH=4096
TEMPERATURE=0.7
TOP_P=0.9
MAX_TOKENS=512

# Security Configuration
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=3600
ALLOWED_ORIGINS=*

# Logging
RUST_LOG=info

# Cache Configuration
REDIS_URL=redis://127.0.0.1:6380
REDIS_MAX_MEMORY_MB=2048
REDIS_TTL_SECONDS=86400
SQLITE_PATH=data/ai_cache.sqlite
SQLITE_MAX_SIZE_GB=10
SQLITE_TTL_DAYS=30
SIMILARITY_THRESHOLD=0.92
MAX_SIMILAR_RESULTS=3
MEMORY_CACHE_ENTRIES=512
MEMORY_TTL_SECONDS=3600
CACHE_PROBABILITY=1.0
